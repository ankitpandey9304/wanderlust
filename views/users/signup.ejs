<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <h1 class="col-8  offset-3 mt-3">Signup on wanderlust</h1>
      <div class="col-8  offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
     <div class="mb-3">
        <lable for="username" class="from-label">Username</lable>
        <input name="username" id="username" type="text"  class="form-control" required/>
        <div class="valid-feedback"> looks good!</div>
        <div class="invalid-feedback">username should be valid</div>
      </div>
      <div class="mb-3">
        <lable for="email" class="from-label">Email</lable>
        <input name="email" id="email" type="email"  class="form-control" required/>
        <div class="valid-feedback"> looks good!</div>
        <div class="invalid-feedback">email should be valid</div>
      </div>
      <div class="mb-3">
        <lable for="password" class="from-label">password</lable>
        <input name="password" id="password" type="password"  class="form-control" required/>
        <div class="valid-feedback"> looks good!</div>
        <div class="invalid-feedback">password should be valid</div>
      </div>
      <button class="btn btn-success">Submit</button>
        </form>
      </div>
</div>