
<style>
  /* Navbar */
  .navbar {
    background-color: #fff;
    padding: 0.7rem 1rem;
  }

  .navbar-brand {
    font-size: 1.7rem;
    color: #fe424d;
  }

  .navbar-brand:hover {
    color: #fe424d;
  }

  .navbar-nav .nav-link {
    font-weight: 500;
    color: #222;
    transition: color 0.2s ease;
  }

  .navbar-nav .nav-link:hover {
    color: #fe424d;
  }

  /* Search form - Desktop */
  .search-form {
    display: flex;
    align-items: center;
    margin: 0 auto;
  }

  .search {
    width: 250px;
    border-radius: 25px;
    padding: 0.5rem 1rem;
  }

  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0.5rem 1.2rem;
    border: none;
    white-space: nowrap;
  }

  .btn-search:hover {
    background-color: #e93642;
    color: #fff;
  }

  .btn-search i {
    margin-right: 0.5rem;
  }

  /* Mobile Responsive */
  @media (max-width: 767px) {

    .navbar {
      padding: 0.7rem 1rem;
    }

    /* Hide search box on mobile */
    .search-form {
      display: none !important;
    }

    /* Mobile menu spacing */
    .navbar-collapse {
      padding-top: 1rem;
    }

    .navbar-nav {
      width: 100%;
    }

    .navbar-nav .nav-link {
      padding: 0.7rem 0.5rem;
    }

    /* Right-side links */
    .navbar-actions {
      border-top: 1px solid #ddd;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>


<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <div class="container-fluid">

    <!-- Brand Logo -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- Mobile Hamburger Button -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation">

      <span class="navbar-toggler-icon"></span>

    </button>


    <!-- Navbar Content -->
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- Left Navigation -->
      <div class="navbar-nav">

        <a class="nav-link" href="/listings">
          Explore
        </a>

      </div>


      <!-- Search Bar (Desktop Only) -->
      <form
        class="search-form"
        role="search"
        action="/listings"
        method="GET">

        <input
          class="form-control search me-2"
          type="search"
          name="search"
          placeholder="Search destination"
          aria-label="Search destination">

        <button class="btn btn-search" type="submit">
          <i class="fa-brands fa-sistrix"></i>
          Search
        </button>

      </form>


      <!-- Right Navigation -->
      <div class="navbar-nav ms-md-auto navbar-actions">

        <a class="nav-link" href="/listings/new">
          Airbnb your home
        </a>

        <% if (!currUser) { %>

          <a class="nav-link" href="/signup">
            <b>Sign up</b>
          </a>

          <a class="nav-link" href="/login">
            <b>Log in</b>
          </a>

        <% } %>


        <% if (currUser) { %>

          <a class="nav-link" href="/logout">
            <b>Log out</b>
          </a>

        <% } %>

      </div>

    </div>

  </div>

</nav>
